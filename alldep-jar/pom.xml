<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.github.sumeetchhetri.gatf</groupId>
		<artifactId>gatf-parent</artifactId>
		<version>5.0.0</version>
	</parent>
	
	<artifactId>gatf-alldep-jar</artifactId>
	<packaging>jar</packaging>
	<name>gatf-alldep-jar</name>

	<properties>
		<!-- Phase 3: set -DskipFrontend=true to build the JAR without (re)building the React shell. -->
		<skipFrontend>false</skipFrontend>
		<frontend.node.version>v22.11.0</frontend.node.version>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>
			<!--  plugin>
	            <groupId>org.apache.maven.plugins</groupId>
	            <artifactId>maven-assembly-plugin</artifactId>
	            <executions>
	                <execution>
	                    <id>gatf-resources</id>
	                    <phase>package</phase>
	                    <goals>
	                        <goal>single</goal>
	                    </goals>
	                    <configuration>
	                    	<finalName>gatf-resources</finalName>
	                    	<appendAssemblyId>false</appendAssemblyId>
	                        <descriptor>gatf-resources.xml</descriptor>
	                        <outputDirectory>${project.build.directory}/classes</outputDirectory>
	                    </configuration>
	                </execution>
	                <execution>
	                    <id>gatf-config-tool</id>
	                    <phase>package</phase>
	                    <goals>
	                        <goal>single</goal>
	                    </goals>
	                    <configuration>
	                    	<finalName>gatf-config-tool</finalName>
	                    	<appendAssemblyId>false</appendAssemblyId>
	                        <descriptor>gatf-config-tool.xml</descriptor>
	                        <outputDirectory>${project.build.directory}/classes</outputDirectory>
	                    </configuration>
	                </execution>
	            </executions>
	        </plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
						        <filter>
						            <artifact>*:*</artifact>
						            <excludes>
						                <exclude>META-INF/*.SF</exclude>
						                <exclude>META-INF/*.DSA</exclude>
						                <exclude>META-INF/*.RSA</exclude>
						            </excludes>
						        </filter>
						    </filters>
							<shadedArtifactAttached>false</shadedArtifactAttached>
            				<createDependencyReducedPom>true</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.gatf.generator.core.GatfTestGeneratorUtil</mainClass>
								</transformer>
								<!-- https://github.com/SeleniumHQ/selenium/issues/10132 -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Phase 3: build the embedded React shell + Trace Viewer (frontend/) into
			     target/classes/gatf-viewer so the shade plugin packages it into the single JAR.
			     Served at /app by GatfConfigToolUtil. Skip with -DskipFrontend=true. -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.1</version>
				<configuration>
					<workingDirectory>${project.parent.basedir}/frontend</workingDirectory>
					<installDirectory>${project.parent.basedir}/frontend/.mvn-node</installDirectory>
					<skip>${skipFrontend}</skip>
				</configuration>
				<executions>
					<execution>
						<id>frontend-install-node-npm</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>${frontend.node.version}</nodeVersion>
						</configuration>
					</execution>
					<execution>
						<id>frontend-npm-ci</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>
					<execution>
						<id>frontend-npm-build</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build -- --outDir ${project.build.outputDirectory}/gatf-viewer --emptyOutDir</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>xml-apis</groupId>
				<artifactId>xml-apis</artifactId>
				<version>1.4.01</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- delta-049: pure-Java compiler (Eclipse ECJ) so GATF compiles seleasy on a plain JRE with
		     no JDK/javac. Discovered only at runtime via java.util.ServiceLoader; no source references
		     ECJ, so this dependency does not affect compilation. Match the version to your target
		     runtime JRE (this build is unaffected by the choice). -->
		<dependency>
			<groupId>org.eclipse.jdt</groupId>
			<artifactId>ecj</artifactId>
			<version>3.33.0</version>
		</dependency>
	</dependencies>
</project>
