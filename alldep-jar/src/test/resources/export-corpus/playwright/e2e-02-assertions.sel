// Δ160 export e2e: assertions, soft assertions, waits and select against the fixture page.
open chrome
goto ${baseUrl}/index.html
?? css@'h1' text ='Welcome'
?? title ='GATF export fixture'
?? id@count text !='0'
??~ id@count text ='3'
?? id@email attr@placeholder ='you@example.com'
type 'abc' id@email
?? id@email attr@value ='abc'
select text@'Medium' id@size
?? id@size attr@value ='m'
// seleasy compares expected.op(actual): this passes once the late banner reads 'Banner shown'
?? id@banner text %'Banner shown later'
var n 'Banner'
?? id@banner text %'$v{n} shown later'
?? id@banner text '$v{n} shown'%
?? id@count text <='3'
??- id@banner
??+ id@ghost
?? id@size tagname ='select'
