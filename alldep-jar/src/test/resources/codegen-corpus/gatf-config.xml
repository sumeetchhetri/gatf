<gatf-execute-config>
  <testCaseDir>tests</testCaseDir>
  <outFilesDir>out</outFilesDir>
  <authEnabled>false</authEnabled>
  <soapAuthEnabled>false</soapAuthEnabled>
  <numConcurrentExecutions>1</numConcurrentExecutions>
  <concurrentUserSimulationNum>0</concurrentUserSimulationNum>
  <compareEnabled>false</compareEnabled>
  <gatfTestDataConfig>
    <globalVariables/>
  </gatfTestDataConfig>
  <enabled>true</enabled>
  <loadTestingEnabled>false</loadTestingEnabled>
  <isOrderByFileName>true</isOrderByFileName>
  <isSeleniumExecutor>true</isSeleniumExecutor>
  <seleniumDriverConfigs>
    <seleniumDriverConfigs>
      <name>chrome</name>
      <driverName>webdriver.chrome.driver</driverName>
      <path>chromedriver</path>
      <capabilities/>
      <properties/>
    </seleniumDriverConfigs>
  </seleniumDriverConfigs>
  <autoPauseOnElNotFound>false</autoPauseOnElNotFound>
</gatf-execute-config>
