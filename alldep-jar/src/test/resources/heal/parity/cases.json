  "name": "form",
  "html": "<!DOCTYPE html><html><head><title>Shop</title><style>.x{display:none}</style></head><body>\n<header><nav aria-label=\"Main\"><a href=\"/home\">Home</a><a>not a link</a></nav></header>\n<main>\n<h1>Welcome back</h1>\n<h2 id=\"sub\">Orders <small>(3)</small></h2>\n<form id=\"f1\">\n<label for=\"email\">Email address</label><input id=\"email\" type=\"email\" placeholder=\"you@example.com\">\n<label>Password <input id=\"pw\" type=\"password\" data-pick=\"pw\"></label>\n<span id=\"lbl-q\">Search</span><input id=\"q\" type=\"search\" aria-labelledby=\"lbl-q\">\n<input id=\"age\" type=\"number\" aria-label=\"Age\" data-pick=\"age\">\n<input type=\"checkbox\" id=\"tos\" checked><label for=\"tos\">Accept terms</label>\n<select id=\"country\" title=\"Country\"><option>India</option><option selected>Nepal</option></select>\n<button type=\"submit\" data-testid=\"save-btn\" class=\"btn primary\" data-pick=\"save\">Save</button>\n<button type=\"button\" data-qa=\"cancel\" class=\"btn\" data-pick=\"cancel\">Cancel</button>\n<button type=\"button\" hidden>Save</button>\n<button type=\"button\" aria-pressed=\"true\">Bold</button>\n<input type=\"submit\" value=\"Save draft\" data-pick=\"draft\">\n</form>\n<img src=\"a.png\" alt=\"Company logo\"><img src=\"b.png\" alt=\"\">\n<p>Total: <b>42</b> items</p>\n<p>Saved &nbsp;  at noon</p>\n<div role=\"dialog\" aria-labelledby=\"dlg-t\"><h3 id=\"dlg-t\">Confirm</h3><button data-pick=\"ok\">OK</button></div>\n<div style=\"display: none\"><button>Ghost</button></div>\n<div style=\"visibility:hidden\"><button>Phantom</button><button style=\"visibility: visible\" data-pick=\"vis\">Phantom</button></div>\n<div aria-hidden=\"true\"><button>Muted</button></div>\n<span title=\"Close panel\">x</span>\n<ul><li><a href=\"#a\" class=\"item\">Item</a></li><li><a href=\"#b\" class=\"item\" data-pick=\"item2\">Item</a></li><li><a href=\"#c\" class=\"item\">Other</a></li></ul>\n<fieldset><legend>Shipping &amp; billing</legend><input name=\"zip\" data-pick=\"zip\"></fieldset>\n<table><caption>Orders table</caption><tr><th>Id</th><td>1</td></tr></table>\n<x-card id=\"card\"><template shadowrootmode=\"open\"><label for=\"inner\">Coupon</label><input id=\"inner\" data-pick=\"inner\"><button>Apply</button><p>In shadow text</p></template><span>light</span></x-card>\n<template><button>Inert</button></template>\n<section aria-label=\"Promo\"><button title=\"Promo close\">X</button></section>\n<article><header>Art head</header></article>\n<footer>Foot</footer>\n<input type=\"hidden\" name=\"csrf\" value=\"t\">\n<div class=\"dup\"><span class=\"dup\">a</span></div><div class=\"dup\" data-pick=\"dup2\"><span>b</span></div>\n</main></body></html>",
