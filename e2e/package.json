{
  "name": "gatf-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end tests for the GATF /app SPA (drives a live GATF server seeded with sample-project).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "install-browser": "playwright install chromium",
    "test:export": "node export/prepare.mjs && playwright test -c export/playwright.config.ts",
    "typecheck:export": "node export/typecheck.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
