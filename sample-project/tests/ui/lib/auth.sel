// Reusable authentication subtests.
// ${baseUrl}, ${username}, ${password} come from app.properties (loaded via `config` in setup.sel).

subtest "doLogin"
{
  goto ${baseUrl}/login
  ??10 id@"username"
  type "${username}" id@"username"
  type "${password}" id@"password"
  click text@"Sign In"
  ??10 css@"nav.app-menu"
  // e2e edit
  // e2e edit
  // e2e edit
  ?? css@"nav.app-menu" visible
}

subtest "doLogout"
{
  ??+ css@"a.logout"
  ??- css@"a.logout" click
  ??10 id@"username"
  ?? id@"username" visible
}
