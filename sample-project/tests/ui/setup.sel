// ── Reusable setup ──────────────────────────────────────────────
// Opens the browser, loads project properties + dynamic vars, and signs in.
// The top-level flows `include` this so they don't repeat the boilerplate.
//
// open chrome-dkr / -hdl / -rec now resolve to a normal Grid/local browser (see D-1).
open chrome
maximize

config app.props        // -> ${baseUrl} ${apiBaseUrl} ${username} ${password}
dynprops dynamic.props       // -> ${patientPrefix} ${maxRetries} ${defaultCity}

import lib/auth.sel           // pull in the doLogin / doLogout subtests
@call "doLogin"
