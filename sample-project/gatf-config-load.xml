<gatf-execute-config>
  <!--
    Load-testing config for the bundled Node server (load-server/server.js).
    API mode (isSeleniumExecutor=false) so the API executor + embedded load engine run.

      1) node sample-project/load-server/server.js            # starts :8880
      2) point GATF at THIS config and run the API executor

    testCaseDir is tests/load so ONLY the load suite runs (the ui/ + api/ demo
    suites are untouched). Absolute *BasePath values below match the rest of the
    sample — repoint them to your checkout, or run from this folder.

    Load engine activates only when loadTestingEnabled=true AND loadTestingTime>10000 (ms).
  -->
  <testCasesBasePath>/Users/sumeetc/Projects/GitHub/gatf/sample-project</testCasesBasePath>
  <testCaseDir>tests/load</testCaseDir>
  <outFilesBasePath>/Users/sumeetc/Projects/GitHub/gatf/sample-project</outFilesBasePath>
  <outFilesDir>out-load</outFilesDir>

  <authEnabled>false</authEnabled>
  <soapAuthEnabled>false</soapAuthEnabled>

  <!-- API mode -->
  <isSeleniumExecutor>false</isSeleniumExecutor>
  <isSeleniumModuleTests>false</isSeleniumModuleTests>

  <httpCompressionEnabled>false</httpCompressionEnabled>
  <httpConnectionTimeout>10000</httpConnectionTimeout>
  <httpRequestTimeout>10000</httpRequestTimeout>

  <!-- Load knobs: 25 simulated users, ramped over 5s, 30s run, 6 report samples. -->
  <loadTestingEnabled>true</loadTestingEnabled>
  <loadTestingTime>30000</loadTestingTime>
  <concurrentUserSimulationNum>25</concurrentUserSimulationNum>
  <concurrentUserRampUpTime>5000</concurrentUserRampUpTime>
  <loadTestingReportSamples>6</loadTestingReportSamples>
  <numConcurrentExecutions>25</numConcurrentExecutions>
  <distributedLoadTests>false</distributedLoadTests>

  <compareEnabled>false</compareEnabled>
  <enableTrace>false</enableTrace>

  <gatfTestDataConfig>
    <!-- element-name-keyed map (plain Jackson map, no custom serializer) -->
    <globalVariables>
      <apiBaseUrl>http://localhost:8880</apiBaseUrl>
      <username>sumeet</username>
      <password>demo-pass</password>
    </globalVariables>
  </gatfTestDataConfig>

  <enabled>true</enabled>
  <debugEnabled>false</debugEnabled>
  <isOrderByFileName>true</isOrderByFileName>
  <isServerLogsApiAuthEnabled>false</isServerLogsApiAuthEnabled>
  <isFetchFailureLogs>false</isFetchFailureLogs>
  <repeatSuiteExecutionNum>0</repeatSuiteExecutionNum>
  <isGenerateExecutionLogs>false</isGenerateExecutionLogs>
  <extraProperties/>
  <autoPauseOnElNotFound>false</autoPauseOnElNotFound>
  <waitOnWarnException>0</waitOnWarnException>
  <waitOnFailException>0</waitOnFailException>
</gatf-execute-config>
